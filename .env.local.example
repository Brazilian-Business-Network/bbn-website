# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Cloudinary cloud name (Dashboard → Product Environment). Public: it ends up in
# every image URL. Event media lives under bbn/eventos/AAAA-MM-slug/.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary API key — server only, used by the Search API that lists the event
# folders. Leave the three Cloudinary vars empty and the gallery simply renders
# its placeholder states; the build still succeeds.
CLOUDINARY_API_KEY=

# Cloudinary API secret — server only. Secret: never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=

# Absolute site URL, no trailing slash. Used for metadata, Open Graph, canonical
# URLs and the sitemap. http://localhost:3000 locally; the real domain in production.
NEXT_PUBLIC_SITE_URL=

# The single Formspree form ID every form on the site posts to (formspree.io →
# form → ID). Each form tags its submission with its own _subject.
NEXT_PUBLIC_FORMSPREE_ID=
